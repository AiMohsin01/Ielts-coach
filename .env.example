POSTGRES_DB=ielts_coach
POSTGRES_USER=ielts
POSTGRES_PASSWORD=change_this_for_a_strong_password
DATABASE_URL=postgresql://ielts:change_this_for_a_strong_password@localhost:5432/ielts_coach
JWT_SECRET=replace_with_a_random_32_plus_character_secret
CLIENT_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
# Phase 3: provider is optional until you enable AI evaluation.
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.2
LOCAL_TRANSCRIPTION_URL=
OPENAI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
